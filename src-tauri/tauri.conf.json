{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jaritok",
  "mainBinaryName": "Jaritok",
  "version": "1.0.0",
  "identifier": "com.jaritok.windows",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "자리톡",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
